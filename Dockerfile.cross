FROM rust:1.99.1-bookworm

# The cross-GCC packages alone do not guarantee the target libc development
# headers are installed. Native crates such as ring require them (stdint.h,
# bits/libc-header-start.h, etc.) when they compile C/assembly sources.
RUN dpkg --add-architecture arm64 && dpkg --add-architecture armhf \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       gcc-aarch64-linux-gnu gcc-arm-linux-gnueabihf \
       libc6-dev-arm64-cross libc6-dev-armhf-cross \
       pkg-config libasound2-dev:arm64 libasound2-dev:armhf \
    && rm -rf /var/lib/apt/lists/*

# Fail while building the image if either cross compiler cannot resolve its
# own target C headers, rather than after downloading/compiling Rust crates.
RUN printf '#include <stdint.h>\nint main(void) { return 0; }\n' > /tmp/cross-header-check.c \
    && aarch64-linux-gnu-gcc -c /tmp/cross-header-check.c -o /tmp/check-aarch64.o \
    && arm-linux-gnueabihf-gcc -c /tmp/cross-header-check.c -o /tmp/check-armhf.o \
    && rm -f /tmp/cross-header-check.c /tmp/check-aarch64.o /tmp/check-armhf.o

RUN rustup target add aarch64-unknown-linux-gnu armv7-unknown-linux-gnueabihf
WORKDIR /work
ENV CARGO_INCREMENTAL=0
